# Copy to .env.local and configure a disposable development database
MONGODB_URI=mongodb+srv://REPLACE_ME
MONGODB_DB_NAME=propfusion
BETTER_AUTH_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000


# Optional email delivery (not needed for every local test)
RESEND_API_KEY=
RESEND_FROM_EMAIL=




